{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "tenants-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/tenants/{**catch-all}"
        }
      },
      "doctors-available-slots-route": {
        "ClusterId": "appointments-cluster",
        "Order": -10,
        "Match": {
          "Path": "/api/doctors/{id}/available-slots"
        }
      },
      "doctors-schedule-route": {
        "ClusterId": "appointments-cluster",
        "Order": -10,
        "Match": {
          "Path": "/api/doctors/{id}/schedule"
        }
      },
      "doctors-schedule-item-route": {
        "ClusterId": "appointments-cluster",
        "Order": -10,
        "Match": {
          "Path": "/api/doctors/{id}/schedule/{slotId}"
        }
      },
      "doctors-ratings-batch-route": {
        "ClusterId": "appointments-cluster",
        "Order": -10,
        "Match": {
          "Path": "/api/doctors/ratings"
        }
      },
      "doctors-rating-route": {
        "ClusterId": "appointments-cluster",
        "Order": -10,
        "Match": {
          "Path": "/api/doctors/{id}/rating"
        }
      },
      "doctors-reviews-route": {
        "ClusterId": "appointments-cluster",
        "Order": -10,
        "Match": {
          "Path": "/api/doctors/{id}/reviews"
        }
      },
      "doctors-route": {
        "ClusterId": "doctors-cluster",
        "Match": {
          "Path": "/api/doctors/{**catch-all}"
        }
      },
      "appointments-route": {
        "ClusterId": "appointments-cluster",
        "Match": {
          "Path": "/api/appointments/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "appointments-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity.api:8080"
          }
        }
      },
      "doctors-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://doctors.api:8080"
          }
        }
      },
      "appointments-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://appointments.api:8080"
          }
        }
      }
    }
  }
}